<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hc_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hc_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_notif_access"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_notif_access" />

                <Button
                    android:id="@+id/btn_accessibility"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:text="@string/btn_accessibility" />

                <Button
                    android:id="@+id/btn_battery"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_battery" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_auto_enable"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:text="@string/btn_auto_enable" />

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_enabled" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_enabled" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_aod_light" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_aod_light" />
            <TextView style="@style/SettingSummary" android:text="@string/set_aod_light_sum" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_blackout_full" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_blackout_full" />
            <TextView style="@style/SettingSummary" android:text="@string/set_blackout_full_sum" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_screen_on_light" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_screen_on_light" />
            <TextView style="@style/SettingSummary" android:text="@string/set_screen_on_light_sum" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_double_tap" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_double_tap" />
            <TextView style="@style/SettingSummary" android:text="@string/set_double_tap_sum" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_clear_unlock" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_clear_unlock" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_relight_relock" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_relight_relock" />
            <TextView style="@style/SettingSummary" android:text="@string/set_relight_relock_sum" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_canvas_fallback" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_canvas_fallback" />
            <TextView style="@style/SettingSummary" android:text="@string/set_canvas_fallback_sum" />

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="10dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <TextView style="@style/SectionLabel" android:text="@string/sec_appearance" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_style"
                    android:labelFor="@+id/sp_style" />
                <Spinner android:id="@+id/sp_style" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_anim"
                    android:labelFor="@+id/sp_anim" />
                <Spinner android:id="@+id/sp_anim" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>

            <TextView style="@style/SliderLabel" android:text="@string/set_color" />
            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_auto_color" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_auto_color" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_eco" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_eco" />

            <TextView android:id="@+id/lbl_timeout" style="@style/SliderLabel"
                android:labelFor="@+id/sb_timeout" />
            <SeekBar android:id="@+id/sb_timeout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="290"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_awake_panel" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_awake_panel" />
            <TextView style="@style/SettingSummary" android:text="@string/set_awake_panel_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_follow_brightness" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_follow_brightness" />
            <TextView style="@style/SettingSummary" android:text="@string/set_follow_brightness_sum" />
            <TextView android:id="@+id/tv_brightness_auto" style="@style/SettingSummary"
                android:textColor="@color/hc_accent" android:visibility="gone"
                android:text="@string/brightness_adaptive_off" />

            <TextView android:id="@+id/lbl_brightness" style="@style/SliderLabel"
                android:labelFor="@+id/sb_brightness" />
            <SeekBar android:id="@+id/sb_brightness" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="95"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <TextView style="@style/SettingSummary" android:text="@string/set_brightness_sum" />

            <TextView android:id="@+id/lbl_stroke" style="@style/SliderLabel"
                android:labelFor="@+id/sb_stroke" />
            <SeekBar android:id="@+id/sb_stroke" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="14"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <TextView android:id="@+id/lbl_speed" style="@style/SliderLabel"
                android:labelFor="@+id/sb_speed" />
            <SeekBar android:id="@+id/sb_speed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="37"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_interval" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_interval" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/InlineLabel" android:text="@string/set_interval_on"
                    android:labelFor="@+id/et_interval_on" />
                <EditText android:id="@+id/et_interval_on" style="@style/NumberInput" />
                <TextView style="@style/InlineLabel" android:text="@string/set_interval_off"
                    android:labelFor="@+id/et_interval_off" android:paddingStart="16dp" />
                <EditText android:id="@+id/et_interval_off" style="@style/NumberInput" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <TextView style="@style/SectionLabel" android:text="@string/sec_icons" />
            <TextView style="@style/SettingSummary" android:text="@string/sec_icons_sum" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_icon_source"
                    android:labelFor="@+id/sp_icon_source" />
                <Spinner android:id="@+id/sp_icon_source" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_source_sum" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_icon_tint"
                    android:labelFor="@+id/sp_icon_tint" />
                <Spinner android:id="@+id/sp_icon_tint" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_tint_sum" />

            <TextView android:id="@+id/lbl_icon_size" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_size" />
            <SeekBar android:id="@+id/sb_icon_size" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="72"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_plate" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_plate" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_plate_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_shift" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_shift" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_shift_sum" />

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <TextView style="@style/SectionLabel" android:text="@string/sec_icon_pos" />
            <TextView style="@style/SettingSummary" android:text="@string/sec_icon_pos_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_center_h" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_center_h" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_center_h_sum" />

            <TextView android:id="@+id/lbl_icon_offset_x" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_offset_x" />
            <SeekBar android:id="@+id/sb_icon_offset_x" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="400"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_offset_x_sum" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_icon_y_anchor"
                    android:labelFor="@+id/sp_icon_y_anchor" />
                <Spinner android:id="@+id/sp_icon_y_anchor" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_y_anchor_sum" />

            <TextView android:id="@+id/lbl_icon_offset_y" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_offset_y" />
            <SeekBar android:id="@+id/sb_icon_offset_y" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="600"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_offset_y_sum" />

            <TextView android:id="@+id/lbl_icon_per_row" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_per_row" />
            <SeekBar android:id="@+id/sb_icon_per_row" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="8"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_per_row_sum" />

            <TextView android:id="@+id/lbl_icon_gap" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_gap" />
            <SeekBar android:id="@+id/sb_icon_gap" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="64"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <TextView android:id="@+id/lbl_icon_row_gap" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_row_gap" />
            <SeekBar android:id="@+id/sb_icon_row_gap" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="96"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_gaps_sum" />

            <TextView android:id="@+id/lbl_icon_max" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_max" />
            <SeekBar android:id="@+id/sb_icon_max" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="23"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_max_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_last_row" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_last_row" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_last_row_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_clip" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_clip" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_clip_sum" />

            <Button android:id="@+id/btn_icon_reset" style="@style/BtnSecondary"
                android:layout_marginTop="6dp" android:text="@string/btn_icon_reset" />

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <TextView style="@style/SectionLabel" android:text="@string/sec_icon_count" />
            <TextView style="@style/SettingSummary" android:text="@string/sec_icon_count_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_count" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_count" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_count_sum" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_icon_count_source"
                    android:labelFor="@+id/sp_icon_count_source" />
                <Spinner android:id="@+id/sp_icon_count_source" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_count_source_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_count_add" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_count_add" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_count_add_sum" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_count_always" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_count_always" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_count_always_sum" />

            <TextView android:id="@+id/lbl_icon_count_size" style="@style/SliderLabel"
                android:labelFor="@+id/sb_icon_count_size" />
            <SeekBar android:id="@+id/sb_icon_count_size" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="18"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent"
                android:secondaryProgressTint="@color/hc_border" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_icon_count_badge" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_icon_count_badge" />
            <TextView style="@style/SettingSummary" android:text="@string/set_icon_count_badge_sum" />

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <TextView style="@style/SectionLabel" android:text="@string/sec_behavior" />

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_night" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_night" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/InlineLabel" android:text="@string/set_night_start"
                    android:labelFor="@+id/et_night_start" />
                <EditText android:id="@+id/et_night_start" style="@style/TimeInput" />
                <TextView style="@style/InlineLabel" android:text="@string/set_night_end"
                    android:labelFor="@+id/et_night_end" android:paddingStart="16dp" />
                <EditText android:id="@+id/et_night_end" style="@style/TimeInput" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_dnd" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_dnd" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_battery_light" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_battery_light" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/sw_ignore_persistent" style="@style/SettingSwitch"
                app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                android:text="@string/set_ignore_persistent" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="48dp">
                <TextView style="@style/InlineLabel" android:text="@string/set_filter"
                    android:labelFor="@+id/sp_filter" />
                <Spinner android:id="@+id/sp_filter" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:backgroundTint="@color/hc_accent" />
            </LinearLayout>

            <Button android:id="@+id/btn_select_apps" style="@style/BtnPrimary"
                android:layout_width="match_parent" android:layout_marginTop="6dp"
                android:text="@string/btn_select_apps" />

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:layout_marginTop="14dp" android:layout_marginBottom="6dp"
                android:background="@color/hc_border" />

            <TextView style="@style/SectionLabel" android:text="@string/sec_cutout" />

            <Button android:id="@+id/btn_detect_cutout" style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:text="@string/btn_detect_cutout" />

            <TextView android:id="@+id/lbl_cutout_x" style="@style/SliderLabel"
                android:labelFor="@+id/sb_cutout_x" />
            <SeekBar android:id="@+id/sb_cutout_x" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="200"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent" />

            <TextView android:id="@+id/lbl_cutout_y" style="@style/SliderLabel"
                android:labelFor="@+id/sb_cutout_y" />
            <SeekBar android:id="@+id/sb_cutout_y" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="200"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent" />

            <TextView android:id="@+id/lbl_cutout_scale" style="@style/SliderLabel"
                android:labelFor="@+id/sb_cutout_scale" />
            <SeekBar android:id="@+id/sb_cutout_scale" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:max="150"
                android:progressTint="@color/hc_accent" android:thumbTint="@color/hc_accent" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="16dp">
                <Button android:id="@+id/btn_test" style="@style/BtnPrimary"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_test" />
                <Button android:id="@+id/btn_hide" style="@style/BtnSecondary"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_hide" />
            </LinearLayout>

            <Button android:id="@+id/btn_toggle_log" style="@style/BtnSecondary"
                android:layout_width="match_parent" android:layout_marginTop="10dp"
                android:text="@string/log_show" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/debug_text"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:visibility="gone"
        android:text=""
        android:textAlignment="textStart"
        android:textColor="@color/hc_text_dim"
        android:textSize="13sp"
        android:typeface="monospace"
        android:gravity="bottom"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@color/hc_surface" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:background="@color/hc_surface"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

</LinearLayout>
