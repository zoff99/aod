<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The halo: three layered strokes of decreasing width and increasing
         alpha make a glow without any blur, exactly like the light the app
         draws on the always-on screen. -->
    <path android:pathData="M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:fillColor="#00000000"
        android:strokeWidth="26.4" android:strokeAlpha="0.05">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="22" android:startY="22"
                android:endX="86" android:endY="86"
                android:startColor="#FF00E5FF" android:endColor="#FFD946EF" />
        </aapt:attr>
    </path>
    <path android:pathData="M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:fillColor="#00000000"
        android:strokeWidth="20.4" android:strokeAlpha="0.07">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="22" android:startY="22"
                android:endX="86" android:endY="86"
                android:startColor="#FF00E5FF" android:endColor="#FFD946EF" />
        </aapt:attr>
    </path>
    <path android:pathData="M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:fillColor="#00000000"
        android:strokeWidth="15" android:strokeAlpha="0.11">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="22" android:startY="22"
                android:endX="86" android:endY="86"
                android:startColor="#FF00E5FF" android:endColor="#FFD946EF" />
        </aapt:attr>
    </path>
    <path android:pathData="M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:fillColor="#00000000"
        android:strokeWidth="10.2" android:strokeAlpha="0.2">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="22" android:startY="22"
                android:endX="86" android:endY="86"
                android:startColor="#FF00E5FF" android:endColor="#FFD946EF" />
        </aapt:attr>
    </path>
    <path android:pathData="M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0"
        android:fillColor="#00000000"
        android:strokeWidth="6" android:strokeAlpha="1">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="22" android:startY="22"
                android:endX="86" android:endY="86"
                android:startColor="#FF00E5FF" android:endColor="#FFD946EF" />
        </aapt:attr>
    </path>

    <!-- Camera lens inside the halo. -->
    <path android:pathData="M41.4,54 a12.6,12.6 0 1,0 25.2,0 a12.6,12.6 0 1,0 -25.2,0" android:fillColor="#FF0A0F1E" />
    <path android:pathData="M41.4,54 a12.6,12.6 0 1,0 25.2,0 a12.6,12.6 0 1,0 -25.2,0" android:fillColor="#00000000"
        android:strokeWidth="0.7" android:strokeAlpha="0.45" android:strokeColor="#FF5B6B9E" />
    <path android:pathData="M47.3,49.4 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" android:fillColor="#809FB4E8" />

    <!-- Notification badge riding on the halo, with a dark collar so it stays
         separate from the ring, and its own little bloom. -->
    <path android:pathData="M62,34 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="74" android:centerY="34" android:gradientRadius="12"
                android:startColor="#8CFF3DCB" android:endColor="#00FF3DCB" />
        </aapt:attr>
    </path>
    <path android:pathData="M65.9,34 a8.1,8.1 0 1,0 16.2,0 a8.1,8.1 0 1,0 -16.2,0" android:fillColor="#FF07080C" />
    <path android:pathData="M67.4,34 a6.6,6.6 0 1,0 13.2,0 a6.6,6.6 0 1,0 -13.2,0" android:fillColor="#FFFF3DCB" />
    <path android:pathData="M70.2,31.9 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" android:fillColor="#BFFFD6F3" />
</vector>
