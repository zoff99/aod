<?xml version="1.0" encoding="utf-8"?>
<!-- Required by RecyclerView even though horizontal fast-scroll is off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF66F0FF" />
            <corners android:radius="4dp" />
            <size android:width="56dp" android:height="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hc_accent" />
            <corners android:radius="4dp" />
            <size android:width="56dp" android:height="8dp" />
        </shape>
    </item>
</selector>
