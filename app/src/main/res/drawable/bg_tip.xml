<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet plate behind an inline tip: raised off the black background,
     with a hairline edge so it reads as one block, not as loose text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/hc_surface" />
    <stroke android:width="1dp" android:color="@color/hc_surface2" />
    <corners android:radius="14dp" />
</shape>
