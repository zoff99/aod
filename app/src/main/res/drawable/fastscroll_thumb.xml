<?xml version="1.0" encoding="utf-8"?>
<!-- RecyclerView requires the fast-scroll thumb to be a StateListDrawable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF66F0FF" />
            <corners android:radius="4dp" />
            <size android:width="10dp" android:height="56dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hc_accent" />
            <corners android:radius="4dp" />
            <size android:width="8dp" android:height="56dp" />
        </shape>
    </item>
</selector>
