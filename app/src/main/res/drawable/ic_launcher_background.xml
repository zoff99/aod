<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A rounded-square card, kept inside the area every launcher mask
         preserves, so the corners are never cut off. Nothing else: no glow,
         no lens, no gradient noise - just a quiet dark surface. -->
    <path android:pathData="M40,25 H68 A15,15 0 0 1 83,40 V68 A15,15 0 0 1 68,83 H40 A15,15 0 0 1 25,68 V40 A15,15 0 0 1 40,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="25" android:startY="25"
                android:endX="83" android:endY="83"
                android:startColor="#FF171C28" android:endColor="#FF0B0E15" />
        </aapt:attr>
    </path>
    <!-- hairline edge, so the card still reads on a black wallpaper -->
    <path android:pathData="M40,25 H68 A15,15 0 0 1 83,40 V68 A15,15 0 0 1 68,83 H40 A15,15 0 0 1 25,68 V40 A15,15 0 0 1 40,25 Z" android:fillColor="#00000000"
        android:strokeWidth="0.6" android:strokeColor="#1AFFFFFF" />
</vector>
