<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep indigo falling away to near-black, corner to corner. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#FF221852" android:endColor="#FF05060C" />
        </aapt:attr>
    </path>

    <!-- A soft cyan lift behind the halo, and a violet one behind the badge,
         so the flat black never looks dead. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="46"
                android:startColor="#2900E5FF" android:endColor="#0000E5FF" />
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="74" android:centerY="30" android:gradientRadius="40"
                android:startColor="#21D946EF" android:endColor="#00D946EF" />
        </aapt:attr>
    </path>
</vector>
